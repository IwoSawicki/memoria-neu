---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  site,
  urnenGalerie,
  urnenGroessen,
  urnenMaterialien,
} from '../data/site';
---

<BaseLayout
  title="Tierurnen & Andenken – Tierbestattung Memoria"
  description="Tierurnen aus Keramik, Holz, Naturstein und Messing, Andenken und individuelle Beschriftung. Katalog als PDF ansehen. Tierbestattung Memoria in Laudenbach."
  solidHeader={true}
>
  <main>
    <!-- Kopfbereich mit Bildcollage -->
    <section class="intro">
      <div class="inner intro-grid">
        <div class="intro-text">
          <p class="eyebrow">Tierurnen &amp; Andenken</p>
          <h1>Eine Urne, die zu Ihrem Tier passt.</h1>
          <p class="lead">
            Ob schlicht oder mit Motiv, aus Keramik, Holz oder Naturstein: Sie
            wählen in Ruhe aus, was sich für Sie richtig anfühlt. Unsere gesamte
            Auswahl – mit Größen und Preisen – finden Sie in unserem Katalog.
          </p>
          <div class="intro-actions">
            <a class="btn-primary" href="#katalog">Katalog ansehen</a>
            <a class="btn-outline" href={site.phoneHref}>
              Beratung · {site.phoneDisplay}
            </a>
          </div>
        </div>

        <div class="intro-collage" aria-hidden="true">
          <img src={urnenGalerie[0].img} alt="" width="560" height="640" loading="eager" />
          <img src={urnenGalerie[2].img} alt="" width="560" height="640" loading="eager" />
          <img src={urnenGalerie[1].img} alt="" width="560" height="640" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- Hinweis Pfotenabdruck -->
    <section class="hinweis-band">
      <div class="inner">
        <div class="note">
          <svg width="24" height="24" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="9.2" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M11 6.6v5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            <circle cx="11" cy="15.2" r="1" fill="currentColor"></circle>
          </svg>
          <p>
            <strong>Bitte frühzeitig sagen:</strong> Wenn Sie sich einen
            Pfotenabdruck oder eine Locke Ihres Tieres wünschen, brauchen wir
            diese Angabe <strong>direkt beim Empfang des Tieres</strong>.
          </p>
        </div>
      </div>
    </section>

    <!-- Galerie -->
    <section class="galerie">
      <div class="inner">
        <h2>Ein kleiner Einblick</h2>
        <p class="section-lead">
          Eine Auswahl beliebter Modelle. Im Katalog finden Sie das gesamte
          Sortiment – nach Materialien geordnet, mit allen Größen und Preisen.
        </p>

        <div class="cards-grid">
          {
            urnenGalerie.map((u) => (
              <figure class="urne">
                <div class="urne-img">
                  <img src={u.img} alt={`Tierurne ${u.name}`} width="560" height="640" loading="lazy" />
                </div>
                <figcaption>
                  <span class="urne-name">{u.name}</span>
                  <span class="urne-material">{u.material}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <div class="materialien">
          <h3>Materialien im Katalog</h3>
          <ul class="chips">
            {urnenMaterialien.map((m) => <li>{m}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Größen -->
    <section class="groessen">
      <div class="inner groessen-grid">
        <div>
          <h2>Welche Größe ist die richtige?</h2>
          <p class="section-lead">
            Als Faustregel gilt das Gewicht Ihres Tieres. Die Urne darf
            selbstverständlich größer sein – nur kleiner sollte sie vom
            Fassungsvolumen nicht ausfallen.
          </p>
          <p class="section-note">
            Sie sind unsicher? Rufen Sie uns einfach an, wir finden gemeinsam die
            passende Größe.
          </p>
        </div>

        <div class="tabelle">
          <dl>
            <div class="tabelle-head">
              <dt>Gewicht des Tieres</dt>
              <dd>Mindestgröße</dd>
            </div>
            {
              urnenGroessen.map((g) => (
                <div class="tabelle-row">
                  <dt>{g.gewicht}</dt>
                  <dd>{g.volumen}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- Katalog -->
    <section id="katalog" class="katalog">
      <div class="inner">
        <p class="eyebrow-dark">Katalog</p>
        <h2 class="hell">Die gesamte Auswahl in Ruhe ansehen</h2>
        <p class="katalog-lead">
          Im Katalog finden Sie alle Urnen nach Materialien geordnet, jeweils mit
          erhältlichen Größen und Preisen – dazu Andenken, Bilderrahmen und
          Gipsabdrücke.
        </p>

        <div class="katalog-actions">
          <a class="btn-accent" href={site.katalogPdf} target="_blank" rel="noopener">
            Katalog öffnen (PDF)
          </a>
          <a class="btn-ghost" href={site.katalogPdf} download>
            Herunterladen
          </a>
        </div>

        <!-- Eingebettete Vorschau (auf kleinen Bildschirmen ausgeblendet) -->
        <div class="pdf-frame">
          <object data={site.katalogPdf} type="application/pdf" aria-label="Katalog Tierurnen und Andenken">
            <p class="pdf-fallback">
              Ihr Browser kann die PDF-Vorschau nicht anzeigen.
              <a href={site.katalogPdf} target="_blank" rel="noopener">
                Katalog in neuem Tab öffnen
              </a>.
            </p>
          </object>
        </div>
      </div>
    </section>

    <!-- Individualisierung -->
    <section class="individuell">
      <div class="inner">
        <h2>Ganz persönlich</h2>
        <div class="cards">
          <div class="card">
            <div class="card-icon">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <path d="M5 26.5 24.2 7.3a3 3 0 0 1 4.2 4.2L9.2 30.7 4 32l1.3-5.2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                <path d="M21.5 10 26 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </div>
            <h3>Persönliche Beschriftung</h3>
            <p>
              Die meisten Urnen lassen sich mit einer Folienbeschriftung
              individualisieren – mit dem Namen Ihres Tieres, einem Datum oder
              einem kurzen Satz.
            </p>
            <p class="detail">
              <strong>Farben:</strong> Gold, Silber, Weiß, Schwarz-matt<br />
              <strong>Schriften:</strong> u. a. Freestyle Script, Lucida
              Calligraphy, Calibri, Arial, Bauhaus
            </p>
          </div>

          <div class="card">
            <div class="card-icon">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <path d="M17 4.5 27.5 12l-4 13h-13l-4-13L17 4.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                <path d="M10.5 12h13M17 4.5 13.5 12l3.5 13 3.5-13-3.5-7.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
              </svg>
            </div>
            <h3>Edelsteine aus Asche oder Haaren</h3>
            <p>
              Über unseren Partner Mevisto können aus der Asche oder aus Haaren
              Ihres Tieres persönliche Edelsteine hergestellt werden – ein
              Andenken, das Sie immer bei sich tragen können.
            </p>
            <a class="link" href={site.mevistoUrl} target="_blank" rel="noopener">
              Mehr über Mevisto erfahren →
            </a>
          </div>

          <div class="card">
            <div class="card-icon">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <ellipse cx="17" cy="21.5" rx="6.5" ry="5.5" stroke="currentColor" stroke-width="1.5"></ellipse>
                <ellipse cx="8.5" cy="13" rx="3" ry="3.8" stroke="currentColor" stroke-width="1.5"></ellipse>
                <ellipse cx="25.5" cy="13" rx="3" ry="3.8" stroke="currentColor" stroke-width="1.5"></ellipse>
                <ellipse cx="14" cy="8" rx="2.8" ry="3.5" stroke="currentColor" stroke-width="1.5"></ellipse>
                <ellipse cx="20" cy="8" rx="2.8" ry="3.5" stroke="currentColor" stroke-width="1.5"></ellipse>
              </svg>
            </div>
            <h3>Pfotenabdruck &amp; Andenken</h3>
            <p>
              Auf Wunsch nehmen wir einen Pfotenabdruck ab oder sichern eine
              Locke. Dazu gibt es Bilderrahmen und Gipsabdrücke – kleine Dinge,
              die bleiben.
            </p>
            <p class="detail">
              <strong>Wichtig:</strong> bitte direkt bei der Abholung angeben.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Beratung -->
    <section class="beratung">
      <img
        class="beratung-bg"
        src="/images/contact-1800.webp"
        srcset="/images/contact-1200.webp 1200w, /images/contact-1800.webp 1800w"
        sizes="100vw"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
      <div class="beratung-overlay"></div>
      <div class="inner beratung-inner">
        <p class="eyebrow-dark">Wir sind für Sie da</p>
        <h2 class="hell">Wir beraten Sie gerne persönlich</h2>
        <p class="beratung-lead">
          Sie müssen sich jetzt nicht entscheiden. Rufen Sie uns an oder buchen
          Sie einen Termin – wir gehen die Möglichkeiten in Ruhe mit Ihnen durch
          und beantworten alle Fragen. Auch abends und am Wochenende.
        </p>
        <div class="beratung-actions">
          <a class="btn-accent" href={site.phoneHref}>
            Jetzt anrufen · {site.phoneDisplay}
          </a>
          <a class="btn-ghost" href={site.bookingUrl} target="_blank" rel="noopener">
            Termin online buchen
          </a>
        </div>
        <p class="beratung-mail">
          Lieber schreiben? <a href={site.emailHref}>{site.email}</a>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding-left: clamp(20px, 4vw, 42px);
    padding-right: clamp(20px, 4vw, 42px);
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(30px, 3.9vw, 50px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--heading-dark);
    margin: 0 0 16px;
    text-wrap: balance;
  }
  h2.hell {
    color: var(--text-lightest);
  }
  .section-lead {
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.75;
    color: var(--muted-1);
    max-width: 58ch;
    margin: 0 0 clamp(28px, 3.4vw, 40px);
    text-wrap: pretty;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted-3);
    margin: 0 0 18px;
  }
  .eyebrow-dark {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(207, 227, 107, 0.85);
    margin: 0 0 20px;
  }

  /* --- Buttons --- */
  .btn-primary,
  .btn-outline,
  .btn-accent,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 15px 30px;
    font-size: 16px;
    font-weight: 600;
    min-height: 54px;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--btn-text);
  }
  .btn-primary:hover {
    background: var(--accent-hover);
    color: var(--btn-text);
  }
  .btn-outline {
    border: 1.5px solid var(--heading-dark);
    color: var(--heading-dark);
    font-variant-numeric: tabular-nums;
  }
  .btn-outline:hover {
    background: var(--bg-card);
    color: var(--heading-dark);
  }
  .btn-accent {
    background: var(--accent);
    color: var(--btn-text);
    font-variant-numeric: tabular-nums;
  }
  .btn-accent:hover {
    background: var(--accent-hover);
    color: var(--btn-text);
  }
  .btn-ghost {
    border: 1px solid rgba(238, 243, 224, 0.4);
    color: var(--text-light);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* --- Intro --- */
  .intro {
    background: var(--bg-page);
  }
  .intro-grid {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--heading-dark);
    margin: 0 0 20px;
    max-width: 16ch;
    text-wrap: balance;
  }
  .lead {
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.75;
    color: var(--muted-1);
    max-width: 52ch;
    margin: 0 0 clamp(26px, 3vw, 34px);
    text-wrap: pretty;
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .intro-collage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(10px, 1.4vw, 18px);
    align-items: end;
  }
  .intro-collage img {
    width: 100%;
    height: auto;
    display: block;
    background: #ffffff;
    border-radius: 18px;
    padding: 10px;
  }
  .intro-collage img:nth-child(1) {
    transform: translateY(14px);
  }
  .intro-collage img:nth-child(3) {
    transform: translateY(24px);
  }

  /* --- Hinweis --- */
  .hinweis-band {
    background: var(--bg-page);
    padding-bottom: clamp(40px, 5vw, 64px);
  }
  .note {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--bg-card);
    border-radius: 18px;
    padding: clamp(20px, 2.4vw, 28px);
    color: var(--icon-stroke);
  }
  .note p {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted-2);
    max-width: 70ch;
  }
  .note strong {
    color: var(--heading-dark);
  }
  .note svg {
    flex: 0 0 auto;
    margin-top: 1px;
  }

  /* --- Galerie --- */
  .galerie {
    background: var(--bg-page);
  }
  .galerie .inner {
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  /* Desktop: 4 nebeneinander · Mobil: 2×2 */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 1.8vw, 26px);
  }
  @media (max-width: 900px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .urne {
      padding: 14px 12px 16px;
    }
    .urne-name {
      font-size: 17px;
    }
    .urne-material {
      font-size: 13px;
    }
  }
  .urne {
    margin: 0;
    background: #ffffff;
    border-radius: 18px;
    padding: 18px 18px 20px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .urne:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(22, 38, 12, 0.1);
  }
  .urne-img {
    aspect-ratio: 1 / 1.05;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .urne-img img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: auto;
  }
  .urne-name {
    font-family: var(--font-serif);
    font-size: 19px;
    color: var(--heading-dark);
  }
  .urne-material {
    font-size: 14px;
    color: var(--muted-3);
  }

  .materialien {
    margin-top: clamp(36px, 4.5vw, 56px);
  }
  .materialien h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--heading-dark);
    margin: 0 0 14px;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
  }
  .chips li {
    background: var(--bg-card);
    border-radius: 999px;
    padding: 9px 18px;
    font-size: 15px;
    color: var(--muted-2);
  }

  /* --- Größen --- */
  .groessen {
    background: var(--bg-page);
  }
  .groessen-grid {
    padding-bottom: clamp(64px, 9vw, 120px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .section-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted-2);
    margin: 0;
    max-width: 44ch;
  }
  .tabelle {
    background: var(--bg-card);
    border-radius: 18px;
    padding: clamp(24px, 3vw, 36px);
  }
  .tabelle dl {
    margin: 0;
  }
  .tabelle-head,
  .tabelle-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
  }
  .tabelle-head {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-price);
  }
  .tabelle-head dt,
  .tabelle-head dd {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-3);
    margin: 0;
  }
  .tabelle-head dd,
  .tabelle-row dd {
    text-align: right;
  }
  .tabelle-row {
    padding: 13px 0;
    border-bottom: 1px solid var(--rule-price);
  }
  .tabelle-row:last-child {
    border-bottom: none;
  }
  .tabelle-row dt {
    font-size: 16px;
    color: var(--muted-1);
    margin: 0;
  }
  .tabelle-row dd {
    font-size: 16px;
    color: var(--heading-dark);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  /* --- Katalog --- */
  .katalog {
    background: var(--bg-dark);
    color: var(--text-light);
    border-radius: clamp(20px, 2.6vw, 34px);
  }
  .katalog .inner {
    padding-top: clamp(60px, 8vw, 110px);
    padding-bottom: clamp(60px, 8vw, 110px);
  }
  .katalog-lead {
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.75;
    color: rgba(238, 243, 224, 0.74);
    max-width: 58ch;
    margin: 0 0 clamp(28px, 3.4vw, 38px);
  }
  .katalog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: clamp(28px, 3.4vw, 40px);
  }
  .pdf-frame {
    border-radius: 18px;
    overflow: hidden;
    background: #ffffff;
    height: min(80vh, 900px);
  }
  .pdf-frame object {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .pdf-fallback {
    margin: 0;
    padding: 28px;
    color: var(--muted-2);
  }
  .pdf-fallback a {
    color: var(--heading-dark);
    text-decoration: underline;
  }
  @media (max-width: 767px) {
    .pdf-frame {
      display: none;
    }
  }

  /* --- Individualisierung --- */
  .individuell {
    background: var(--bg-page);
  }
  .individuell .inner {
    padding-top: clamp(64px, 9vw, 120px);
    padding-bottom: clamp(64px, 9vw, 120px);
  }
  .individuell h2 {
    margin-bottom: clamp(28px, 3.4vw, 44px);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(16px, 1.8vw, 26px);
  }
  .card {
    background: var(--bg-card);
    border-radius: 18px;
    padding: clamp(28px, 2.8vw, 38px);
  }
  .card-icon {
    color: var(--icon-stroke);
    margin-bottom: clamp(20px, 3vw, 34px);
    line-height: 0;
  }
  .card h3 {
    font-size: 19px;
    font-weight: 600;
    margin: 0 0 12px;
    color: var(--heading-dark);
  }
  .card p {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted-2);
  }
  .card .detail {
    margin-top: 14px;
    font-size: 15px;
    color: var(--muted-3);
  }
  .card .detail strong {
    color: var(--muted-1);
  }
  .link {
    display: inline-block;
    margin-top: 16px;
    font-size: 16px;
    font-weight: 600;
    color: var(--heading-dark);
    text-decoration: underline;
  }

  /* --- Beratung --- */
  .beratung {
    position: relative;
    overflow: hidden;
    background: var(--bg-contact);
    color: var(--text-light);
  }
  .beratung-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .beratung-overlay {
    position: absolute;
    inset: 0;
    background: var(--contact-overlay);
  }
  .beratung-inner {
    position: relative;
    padding-top: clamp(72px, 10vw, 140px);
    padding-bottom: clamp(72px, 10vw, 140px);
    text-align: center;
  }
  .beratung h2 {
