---
// Vertrauenselement: Gesamtbewertung bei Google, darunter – sobald vorhanden –
// echte Bewertungen als langsam durchlaufendes Band.
//
// Wichtig: `googleReviews` in site.ts ist bewusst leer, solange keine echten
// Texte vorliegen. Ohne Texte zeigt dieser Abschnitt nur die Gesamtbewertung;
// erfundene Bewertungen kommen hier nicht hinein.
import { site, googleReviews } from '../data/site';

const { wert, anzahl, profilUrl } = site.googleRating;
// Für das Band wird die Liste verdoppelt, damit der Umlauf nahtlos wirkt.
const band = [...googleReviews, ...googleReviews];
const wertAnzeige = wert.toLocaleString('de-DE', { minimumFractionDigits: 1 });
---

<section id="bewertungen" class="bewertungen">
  <div class="inner" data-reveal>
    <div class="karte">
      <div class="logo" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30">
          <path
            fill="#4285F4"
            d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47a5.54 5.54 0 0 1-2.4 3.63v3.02h3.88c2.27-2.09 3.54-5.17 3.54-8.89z"
          ></path>
          <path
            fill="#34A853"
            d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.01c-1.08.72-2.45 1.16-4.05 1.16-3.13 0-5.78-2.11-6.73-4.96H1.26v3.09A11.99 11.99 0 0 0 12 24z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.27 14.28a7.17 7.17 0 0 1 0-4.56V6.63H1.26a11.99 11.99 0 0 0 0 10.74l4.01-3.09z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 4.77c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.69 1.26 6.63l4.01 3.09C6.22 6.88 8.87 4.77 12 4.77z"
          ></path>
        </svg>
      </div>

      <p class="wert">{wertAnzeige}</p>

      <div class="sterne" role="img" aria-label={`${wertAnzeige} von 5 Sternen`}>
        {
          [0, 1, 2, 3, 4].map(() => (
            <svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true">
              <path
                fill="#f5b400"
                d="M10 1.6l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.21l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.6z"
              />
            </svg>
          ))
        }
      </div>

      <p class="anzahl">aus {anzahl} Google-Bewertungen</p>

      {
        profilUrl && (
          <a class="profil" href={profilUrl} target="_blank" rel="noopener noreferrer">
            Alle Bewertungen bei Google ansehen
          </a>
        )
      }
    </div>

    {
      googleReviews.length > 0 && (
        <div class="band" data-marquee>
          <div class="spur">
            {band.map((r) => (
              <figure class="stimme">
                <blockquote>{r.text}</blockquote>
                <figcaption>
                  {r.autor}
                  {r.datum && <span class="datum"> · {r.datum}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .bewertungen {
    background: var(--bg-page);
  }

  .inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 42px) clamp(72px, 10vw, 140px);
  }

  /* Bewertungskarte --------------------------------------------------- */
  .karte {
    background: var(--bg-card);
    border-radius: 18px;
    padding: clamp(28px, 3.4vw, 42px);
    text-align: center;
    max-width: 420px;
    margin: 0 auto;
  }

  .logo {
    line-height: 0;
    margin-bottom: 14px;
  }

  .wert {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(46px, 6vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--heading-dark);
    font-variant-numeric: tabular-nums;
    margin: 0 0 10px;
  }

  .sterne {
    display: flex;
    justify-content: center;
    gap: 3px;
    line-height: 0;
    margin-bottom: 10px;
  }

  .anzahl {
    margin: 0;
    font-size: 16px;
    color: var(--muted-2);
  }

  .profil {
    display: inline-block;
    margin-top: 16px;
    font-size: 15px;
    font-weight: 500;
    color: var(--heading-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .profil:hover {
    color: var(--text-link-hover);
  }

  /* Durchlaufendes Band ------------------------------------------------ */
  .band {
    margin-top: clamp(32px, 4vw, 48px);
    overflow: hidden;
    /* Ränder ausblenden, damit die Zitate nicht hart abgeschnitten wirken. */
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
  }

  .spur {
    display: flex;
    gap: clamp(16px, 1.8vw, 26px);
    width: max-content;
    animation: lauf 70s linear infinite;
  }
  .band:hover .spur {
    animation-play-state: paused;
  }

  @keyframes lauf {
    /* Die Liste ist verdoppelt – bei -50 % beginnt sie nahtlos von vorn. */
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .stimme {
    flex: 0 0 min(340px, 78vw);
    margin: 0;
    background: var(--bg-card);
    border-radius: 18px;
    padding: clamp(22px, 2.4vw, 30px);
  }

  .stimme blockquote {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted-2);
    text-wrap: pretty;
  }

  .stimme figcaption {
    font-size: 14px;
    font-weight: 500;
    color: var(--heading-dark);
  }
  .datum {
    font-weight: 400;
    color: var(--muted-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .spur {
      animation: none;
      /* Ohne Bewegung lieber umbrechen als starr abschneiden. */
      flex-wrap: wrap;
      width: auto;
    }
    .band {
      mask-image: none;
    }
  }
</style>
