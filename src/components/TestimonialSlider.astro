---
// Zeigt echte Google-Bewertungen. Die Platzhalter-Zitate aus dem Design-Entwurf
// ("M. K.", "A. B.", "S. R.") sind entfernt – erfundene Kundenstimmen gehören
// nicht auf die Seite eines echten Betriebs.
//
// Solange `googleReviews` in site.ts leer ist, rendert diese Komponente nichts.
// Sobald Bewertungen eingetragen sind, läuft der Slider automatisch.
import { site, googleReviews } from '../data/site';

// Das vorhandene Slider-Skript erwartet { text, author } – hier gemappt.
const quotes = googleReviews.map((r) => ({
  text: r.text,
  author: r.datum ? `${r.autor} · ${r.datum}` : r.autor,
}));
const first = quotes[0];
const bewertung = site.googleRating.wert.toLocaleString('de-DE', {
  minimumFractionDigits: 1,
});
---

{
  quotes.length > 0 && (
    <>

<div class="testimonials">
  <div class="g-kopf">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47a5.54 5.54 0 0 1-2.4 3.63v3.02h3.88c2.27-2.09 3.54-5.17 3.54-8.89z"></path>
      <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.01c-1.08.72-2.45 1.16-4.05 1.16-3.13 0-5.78-2.11-6.73-4.96H1.26v3.09A11.99 11.99 0 0 0 12 24z"></path>
      <path fill="#FBBC05" d="M5.27 14.28a7.17 7.17 0 0 1 0-4.56V6.63H1.26a11.99 11.99 0 0 0 0 10.74l4.01-3.09z"></path>
      <path fill="#EA4335" d="M12 4.77c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.69 1.26 6.63l4.01 3.09C6.22 6.88 8.87 4.77 12 4.77z"></path>
    </svg>
    <span class="g-sterne" aria-hidden="true">
      {[0, 1, 2, 3, 4].map(() => (
        <svg viewBox="0 0 20 20" width="15" height="15">
          <path fill="#f5b400" d="M10 1.6l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.21l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.6z" />
        </svg>
      ))}
    </span>
    <span class="g-text">
      <strong>{bewertung}</strong> aus {site.googleRating.anzahl} Google-Bewertungen
    </span>
  </div>
  <div class="slider">
    <button
      class="arrow"
      data-quoteprev
      type="button"
      aria-label="Vorheriges Zitat"
    >
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path d="M7 1L1 7l6 6M1 7h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div class="quotebox" data-quotebox>
      <p class="quote-text" data-quotetext>{first.text}</p>
      <p class="quote-author" data-quoteauthor>{first.author}</p>
    </div>

    <button
      class="arrow"
      data-quotenext
      type="button"
      aria-label="Nächstes Zitat"
    >
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path d="M11 1l6 6-6 6M17 7H1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <script type="application/json" data-quotes set:html={JSON.stringify(quotes)} />
</div>
    </>
  )
}

<style>
  .g-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(18px, 2.2vw, 28px);
  }
  .g-sterne {
    display: flex;
    gap: 2px;
    line-height: 0;
  }
  .g-text {
    font-size: 15px;
    color: rgba(238, 243, 224, 0.74);
  }
  .g-text strong {
    color: var(--text-lightest);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .testimonials {
    border-top: 1px solid rgba(238, 243, 224, 0.2);
    padding-top: clamp(50px, 6vw, 80px);
  }

  .eyebrow {
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(207, 227, 107, 0.85);
    margin: 0 0 clamp(36px, 5vw, 60px);
  }

  .slider {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 40px);
  }

  .arrow {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid rgba(238, 243, 224, 0.35);
    background: none;
    color: var(--text-light);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .arrow:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .quotebox {
    flex: 1 1 auto;
    min-width: 0;
    min-height: clamp(230px, 26vw, 300px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: opacity 0.9s ease;
  }

  .quote-text {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(24px, 3.2vw, 42px);
    line-height: 1.3;
    color: var(--text-lightest);
    margin: 0 0 clamp(28px, 3.4vw, 44px);
    max-width: 22ch;
    text-wrap: pretty;
  }
  .quote-author {
    font-size: 15px;
    color: rgba(238, 243, 224, 0.6);
    margin: 0;
  }
</style>
