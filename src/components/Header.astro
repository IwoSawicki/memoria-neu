---
import { site, nav } from '../data/site';

interface Props {
  /** overlay = transparent über dem Hero (Startseite), solid = dunkler Balken (Unterseiten) */
  variant?: 'overlay' | 'solid';
}
const { variant = 'overlay' } = Astro.props;
// Auf Unterseiten (solid) zeigt das Logo zur Startseite, sonst zum Seitenanfang.
const isSub = variant === 'solid';
const logoHref = isSub ? '/' : '#top';
// Anker (#ablauf …) funktionieren nur auf der Startseite – auf Unterseiten
// müssen sie auf "/#ablauf" zeigen. Echte Seitenpfade bleiben unverändert.
const navItems = nav.map((item) => ({
  ...item,
  href: isSub && item.href.startsWith('#') ? `/${item.href}` : item.href,
}));
---

<div class:list={['site-header', variant]}>
  <header>
    <a class="logo" href={logoHref}>{site.name}</a>

    <nav class="desktop-nav" aria-label="Hauptnavigation">
      {
        navItems.map((item) => (
          <a class="nav-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a class="phone-btn" href={site.phoneHref}>{site.phoneDisplay}</a>
    </nav>

    <button
      class="menu-btn"
      data-menubtn
      type="button"
      aria-label="Menü"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
    </button>
  </header>

  <div class="menu-panel" data-menupanel>
    {
      navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
  </div>
</div>

<style>
  .site-header {
    z-index: 20;
  }
  /* Overlay: transparent über dem Hero, absolut positioniert – so ändert das
     Aufklappen des Menüs die Hero-Höhe nicht. */
  .site-header.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    transition: background 0.3s ease;
  }
  /* Beim Aufklappen des Mobil-Menüs verschmilzt die Leiste mit dem weißen Sheet. */
  .site-header.overlay.header-open {
    background: #ffffff;
  }
  .site-header.overlay.header-open .logo,
  .site-header.overlay.header-open .logo:hover {
    color: var(--heading-dark);
  }
  .site-header.overlay.header-open .menu-btn span {
    background: var(--heading-dark);
  }
  /* Solid (Unterseiten): weißer Balken mit dunkler Schrift. */
  .site-header.solid {
    position: relative;
    background: #ffffff;
    border-bottom: 1px solid rgba(31, 45, 22, 0.1);
  }
  .site-header.solid .logo,
  .site-header.solid .logo:hover {
    color: var(--heading-dark);
  }
  .site-header.solid .nav-link {
    color: var(--text);
  }
  .site-header.solid .nav-link:hover {
    color: var(--text-link-hover);
  }
  .site-header.solid .menu-btn span {
    background: var(--heading-dark);
  }

  header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(18px, 2.2vw, 30px) clamp(20px, 3vw, 42px);
    max-width: none;
  }

  .logo {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1;
    color: var(--text-lightest);
    transition: color 0.3s ease;
  }
  .logo:hover {
    color: var(--text-lightest);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 30px);
  }
  .nav-link {
    font-size: 15px;
    font-weight: 500;
    color: rgba(247, 249, 238, 0.88);
  }
  .nav-link:hover {
    color: #ffffff;
  }

  .phone-btn {
    background: var(--accent);
    color: var(--btn-text);
    border-radius: 999px;
    padding: 11px 22px;
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .phone-btn:hover {
    background: var(--accent-hover);
    color: var(--btn-text);
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    gap: 7px;
    background: none;
    border: none;
    padding: 12px 2px;
    min-height: 44px;
    cursor: pointer;
  }
  .menu-btn span {
    display: block;
    width: 30px;
    height: 2px;
    background: var(--text-lightest);
    transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
    transform-origin: center;
  }
  /* Burger -> X wenn Menü offen */
  .menu-btn.open span:nth-child(1) {
    transform: translateY(4.5px) rotate(45deg);
  }
  .menu-btn.open span:nth-child(2) {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  /* Mobiles Menü: weißes Sheet, animiert per max-height/opacity. */
  .menu-panel {
    display: none;
    background: #ffffff;
    padding: 0 clamp(20px, 3vw, 42px);
    box-shadow: 0 20px 44px rgba(16, 26, 8, 0.22);
    border-radius: 0 0 18px 18px;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.4s ease;
  }
  .menu-panel.open {
    max-height: 70vh;
    opacity: 1;
    padding-top: 4px;
    padding-bottom: 14px;
  }
  .menu-panel a {
    display: block;
    padding: 15px 2px;
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--heading-dark);
    border-top: 1px solid rgba(31, 45, 22, 0.12);
  }
  .menu-panel a:first-child {
    border-top: none;
  }
  .menu-panel a:hover {
    color: var(--text-link-hover);
  }

  /* Mobil: Desktop-Nav ausblenden, Hamburger einblenden. */
  @media (max-width: 999px) {
    .desktop-nav {
      display: none;
    }
    .menu-btn {
      display: flex;
    }
    .menu-panel {
      display: block;
    }
  }
</style>
