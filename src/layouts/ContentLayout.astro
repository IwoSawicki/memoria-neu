---
// Layout für die redaktionellen SEO-Unterseiten. Bewusst nah am LegalLayout
// gehalten – gleiche Schriften, gleiche Farben, gleiche Abstände – nur mit
// Tabellen, Aufklapp-Fragen und einem Abschlussblock mit Telefonnummer.
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Kleine Zeile über der Überschrift. */
  eyebrow: string;
  /** Die einzige h1 der Seite. */
  heading: string;
  /** Einleitender Absatz direkt unter der h1. */
  lead?: string;
  /** Abschlussblock mit Telefonnummer ausblenden (z. B. wenn die Seite einen eigenen hat). */
  showCta?: boolean;
}
const {
  title,
  description,
  eyebrow,
  heading,
  lead,
  showCta = true,
} = Astro.props;
---

<BaseLayout title={title} description={description} solidHeader={true}>
  <main class="content">
    <div class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>

    <div class="prose">
      <slot />
    </div>

    {
      showCta && (
        <aside class="cta">
          <p class="cta-label">Lieber direkt sprechen?</p>
          <a class="cta-phone" href={site.phoneHref}>
            {site.phoneDisplay}
          </a>
          <p class="cta-note">
            Rund um die Uhr erreichbar, an 365 Tagen im Jahr – auch nachts und
            am Wochenende.
          </p>
        </aside>
      )
    }

    <p class="back"><a href="/">← Zurück zur Startseite</a></p>
  </main>
</BaseLayout>

<style>
  .content {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) clamp(20px, 4vw, 42px)
      clamp(64px, 9vw, 120px);
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted-3);
    margin: 0 0 16px;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--heading-dark);
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .lead {
    font-family: var(--font-serif);
    font-size: clamp(19px, 1.8vw, 23px);
    line-height: 1.55;
    color: var(--about-lead);
    margin: 0 0 8px;
    max-width: 46ch;
    text-wrap: pretty;
  }

  /* Fließtext ---------------------------------------------------------- */
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    color: var(--heading-dark);
    margin: 52px 0 14px;
    text-wrap: pretty;
  }
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    color: var(--heading-dark);
    margin: 32px 0 8px;
  }
  .prose :global(p) {
    color: var(--muted-2);
    margin: 0 0 16px;
    line-height: 1.75;
  }
  .prose :global(ul) {
    color: var(--muted-2);
    margin: 0 0 16px;
    padding-left: 22px;
    line-height: 1.75;
  }
  .prose :global(li) {
    margin: 0 0 8px;
  }
  .prose :global(strong) {
    color: var(--heading-dark);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--heading-dark);
    text-decoration: underline;
  }
  .prose :global(a:hover) {
    color: var(--text-link-hover);
  }

  /* Tabellen ----------------------------------------------------------- */
  /* Der Wrapper darf scrollen, damit auf schmalen Displays nichts überläuft. */
  .prose :global(.table-wrap) {
    overflow-x: auto;
    margin: 0 0 20px;
    background: var(--bg-card);
    border-radius: 18px;
    padding: clamp(20px, 3vw, 32px);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }
  .prose :global(caption) {
    text-align: left;
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--heading-dark);
    margin: 0 0 14px;
  }
  .prose :global(th) {
    text-align: left;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted-3);
    padding: 0 0 10px;
    border-bottom: 1px solid var(--rule-price);
  }
  .prose :global(th:last-child),
  .prose :global(td:last-child) {
    text-align: right;
  }
  .prose :global(td) {
    color: var(--muted-1);
    padding: 13px 0;
    border-bottom: 1px solid var(--rule-price);
  }
  .prose :global(tr:last-child td) {
    border-bottom: none;
  }
  .prose :global(td:last-child) {
    color: var(--heading-dark);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Aufklappbare Fragen ------------------------------------------------ */
  .prose :global(details) {
    border-top: 1px solid var(--rule-price);
    padding: 4px 0;
  }
  .prose :global(details:last-of-type) {
    border-bottom: 1px solid var(--rule-price);
    margin-bottom: 20px;
  }
  .prose :global(summary) {
    cursor: pointer;
    list-style: none;
    padding: 16px 32px 16px 0;
    position: relative;
    font-weight: 500;
    color: var(--heading-dark);
    line-height: 1.5;
  }
  .prose :global(summary::-webkit-details-marker) {
    display: none;
  }
  /* Plus-Zeichen, das beim Öffnen zum Minus wird. */
  .prose :global(summary::after) {
    content: '';
    position: absolute;
    right: 6px;
    top: 50%;
    width: 13px;
    height: 1.6px;
    background: var(--muted-3);
    transform: translateY(-50%);
  }
  .prose :global(summary::before) {
    content: '';
    position: absolute;
    right: 6px;
    top: 50%;
    width: 13px;
    height: 1.6px;
    background: var(--muted-3);
    transform: translateY(-50%) rotate(90deg);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .prose :global(details[open] summary::before) {
    transform: translateY(-50%) rotate(0deg);
    opacity: 0;
  }
  .prose :global(details > :not(summary)) {
    margin-bottom: 16px;
  }

  /* Hervorgehobener Hinweis -------------------------------------------- */
  .prose :global(.hinweis) {
    padding-left: 14px;
    border-left: 2px solid var(--chevron);
    color: var(--muted-3);
    font-size: 15px;
    line-height: 1.65;
    margin: 0 0 20px;
  }

  /* Abschluss ---------------------------------------------------------- */
  .cta {
    margin-top: clamp(48px, 6vw, 72px);
    background: var(--bg-card);
    border-radius: 18px;
    padding: clamp(28px, 3.4vw, 40px);
  }
  .cta-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted-3);
    margin: 0 0 10px;
  }
  .cta-phone {
    display: inline-block;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(30px, 4.4vw, 46px);
    line-height: 1.1;
    color: var(--heading-dark);
    font-variant-numeric: tabular-nums;
    border-bottom: 1px solid var(--chevron);
    margin: 0 0 12px;
  }
  .cta-phone:hover {
    color: var(--text-link-hover);
  }
  .cta-note {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted-2);
    max-width: 44ch;
  }

  .back {
    margin-top: 48px;
  }
  .back a {
    color: var(--heading-dark);
    text-decoration: underline;
  }
</style>
