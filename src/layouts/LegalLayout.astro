---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
}
const { title, description, heading, eyebrow = 'Rechtliches' } = Astro.props;
---

<BaseLayout title={title} description={description} solidHeader={true}>
  <main class="legal">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <div class="prose">
      <slot />
    </div>
    <p class="back"><a href="/">← Zurück zur Startseite</a></p>
  </main>
</BaseLayout>

<style>
  .legal {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) clamp(20px, 4vw, 42px) clamp(64px, 9vw, 120px);
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted-3);
    margin: 0 0 16px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--heading-dark);
    margin: 0 0 32px;
  }

  /* Rich text -------------------------------------------------------- */
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    color: var(--heading-dark);
    margin: 48px 0 14px;
  }
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    color: var(--heading-dark);
    margin: 30px 0 8px;
  }
  .prose :global(p) {
    color: var(--muted-2);
    margin: 0 0 16px;
    line-height: 1.75;
  }
  .prose :global(ul) {
    color: var(--muted-2);
    margin: 0 0 16px;
    padding-left: 22px;
    line-height: 1.75;
  }
  .prose :global(li) {
    margin: 0 0 8px;
  }
  .prose :global(strong) {
    color: var(--heading-dark);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--heading-dark);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }
  .prose :global(a:hover) {
    color: var(--text-link-hover);
  }
  .prose :global(address) {
    font-style: normal;
    color: var(--muted-2);
    line-height: 1.75;
    margin: 0 0 16px;
  }
  .prose :global(.small) {
    font-size: 14px;
    color: var(--muted-3);
  }

  .back {
    margin-top: 56px;
  }
  .back a {
    color: var(--heading-dark);
    text-decoration: underline;
  }
</style>
