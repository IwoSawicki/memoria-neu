---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** true = dunkler Header-Balken (Unterseiten). Auf der Startseite bringt der Hero seinen eigenen Overlay-Header mit. */
  solidHeader?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  solidHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang="de" class="om-nojs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Fonts: Fraunces + Figtree (exakt wie im Design) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..500;1,9..144,300..500&family=Figtree:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {solidHeader && <Header variant="solid" />}

    <slot />

    <Footer />
    {site.showStickyBar && <MobileStickyBar />}

    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
