---
// Selbst gehostete Schriften (kein Google-Server-Aufruf, DSGVO-freundlich).
// Fraunces mit opsz+wght (normal & kursiv), Figtree mit wght.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** true = dunkler Header-Balken (Unterseiten). Auf der Startseite bringt der Hero seinen eigenen Overlay-Header mit. */
  solidHeader?: boolean;
  /** Hero-Bild vorladen (nur Startseite – verbessert den LCP). */
  preloadHero?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  solidHeader = false,
  preloadHero = false,
} = Astro.props;

// Absolute URLs für Canonical & Open Graph (Basis = `site` aus astro.config).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/og.jpg', Astro.site).href;
---

<!doctype html>
<html lang="de" class="om-nojs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2b3a1e" />
    {
      preloadHero && (
        <link
          rel="preload"
          as="image"
          href="/images/hero.webp"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Frau geht mit ihrem Hund durch einen sonnigen Wald"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Umami: cookielose, datenschutzfreundliche Reichweitenmessung */}
    {
      site.umamiSrc && site.umamiWebsiteId && (
        <script
          is:inline
          defer
          src={site.umamiSrc}
          data-website-id={site.umamiWebsiteId}
        />
      )
    }
  </head>
  <body>
    {solidHeader && <Header variant="solid" />}

    <slot />

    <Footer />
    {site.showStickyBar && <MobileStickyBar />}
    {site.googleAnalyticsId && <CookieBanner />}

    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
