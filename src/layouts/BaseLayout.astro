---
// Selbst gehostete Schriften (kein Google-Server-Aufruf, DSGVO-freundlich).
// Fraunces mit opsz+wght (normal & kursiv), Figtree mit wght.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/figtree/wght.css';
// Die beiden Schriftdateien, die oberhalb der Falz gebraucht werden – als URL
// importiert, damit der gehashte Dateiname im Preload stimmt.
import frauncesFont from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import figtreeFont from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** true = dunkler Header-Balken (Unterseiten). Auf der Startseite bringt der Hero seinen eigenen Overlay-Header mit. */
  solidHeader?: boolean;
  /** Hero-Bild vorladen (nur Startseite – verbessert den LCP). */
  preloadHero?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  solidHeader = false,
  preloadHero = false,
} = Astro.props;

// Absolute URLs für Canonical & Open Graph (Basis = `site` aus astro.config).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/og.jpg', Astro.site).href;

// Nur die Live-Domain darf indexiert werden. Auf der Dev-Subdomain wird die
// Seite per noindex gesperrt, damit sie nicht als Dublette bei Google landet.
const isLive = Astro.site?.hostname === 'www.tierbestattung-memoria.de';
---

<!doctype html>
<html lang="de" class="om-nojs">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Muss VOR allem anderen laufen: Browser stellen beim Neuladen die alte
      // Scrollposition wieder her – die Seite startet dann mittendrin und der
      // Header ist weg. "manual" schaltet das ab; Sprünge zu #ankern
      // funktionieren weiterhin.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {!isLive && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#2b3a1e" />
    {
      preloadHero && (
        <link
          rel="preload"
          as="image"
          href="/images/hero-1553.webp"
          imagesrcset="/images/hero-800.webp 800w, /images/hero-1200.webp 1200w, /images/hero-1553.webp 1553w"
          imagesizes="100vw"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    {/* Schriften der ersten Bildschirmseite vorladen – verkürzt die Ladekette. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={frauncesFont}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={figtreeFont}
      crossorigin="anonymous"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Frau geht mit ihrem Hund durch einen sonnigen Wald"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* ####### NUR ZUM TESTEN – ueber site.gaForceLoad abschaltbar #######
        Google Analytics fest im <head>, bei JEDEM Besucher, OHNE Einwilligung.
        Original-Snippet von Google, unveraendert. NICHT DSGVO-konform.
        __gaLoaded verhindert, dass der Cookie-Banner den Tag ein zweites Mal
        laedt, falls jemand zusaetzlich auf "Akzeptieren" klickt. */}
    {
      site.gaForceLoad && site.googleAnalyticsId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}
          />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${site.googleAnalyticsId}');
window.__gaLoaded = true;`}
          />
        </>
      )
    }

    {/* Umami: cookielose, datenschutzfreundliche Reichweitenmessung */}
    {
      site.umamiSrc && site.umamiWebsiteId && (
        <script
          is:inline
          defer
          src={site.umamiSrc}
          data-website-id={site.umamiWebsiteId}
        />
      )
    }
  </head>
  <body>
    {solidHeader && <Header variant="solid" />}

    <slot />

    <Footer />
    {site.showStickyBar && <MobileStickyBar />}
    {site.googleAnalyticsId && <CookieBanner />}

    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
